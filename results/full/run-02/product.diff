+func TestFormatFieldValue(t *testing.T) {
+	tests := []struct {
+		name  string
+		value queries.FieldValueNodes
+		want  string
+	}{
+		{"text strips lines", textValue("field", "one\r\ntwo"), "one two"},
+		{"number is compact", numberValue("field", 12.50), "12.5"},
+		{"date", dateValue("field", "2026-07-29"), "2026-07-29"},
+		{"single select", selectValue("field", "In Progress"), "In Progress"},
+		{"iteration", iterationValue("field", "Sprint 4"), "Sprint 4"},
+		{"milestone", milestoneValue("field", "v2.0"), "v2.0"},
+		{"labels", labelValue("field", []string{"bug", "urgent"}), "bug, urgent"},
+		{"pull requests", pullRequestValue("field", []string{"https://github.com/o/r/pull/1"}), "https://github.com/o/r/pull/1"},
+		{"repository", repositoryValue("field", "https://github.com/o/r"), "https://github.com/o/r"},
+		{"users", userValue("field", []string{"monalisa", "hubot"}), "monalisa, hubot"},
+		{"reviewers", reviewerValue("field", "monalisa", "cli-team"), "monalisa, cli-team"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			item := queries.ProjectItem{}
+			item.FieldValues.Nodes = []queries.FieldValueNodes{tt.value}
+			assert.Equal(t, tt.want, formatFieldValue(item, "field"))
+		})
+	}
+}
