@@ -0,0 +1,117 @@
+package queries
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestFieldValueNodesDisplayValue(t *testing.T) {
+	tests := []struct {
+		name  string
+		value FieldValueNodes
+		want  string
+	}{
+		{name: "date", value: dateValue("2026-07-31"), want: "2026-07-31"},
+		{name: "iteration", value: iterationValue("Sprint 1"), want: "Sprint 1"},
+		{name: "number", value: numberValue(1.25), want: "1.25"},
+		{name: "single select", value: singleSelectValue("In Progress"), want: "In Progress"},
+		{name: "text", value: textValue("notes"), want: "notes"},
+		{name: "milestone", value: milestoneValue("v1"), want: "v1"},
+		{name: "labels", value: labelsValue([]string{"bug", "docs"}), want: "bug, docs"},
+		{name: "pull requests", value: pullRequestsValue([]string{"https://github.com/o/r/pull/1", "https://github.com/o/r/pull/2"}), want: "https://github.com/o/r/pull/1, https://github.com/o/r/pull/2"},
+		{name: "repository", value: repositoryValue("https://github.com/o/r"), want: "https://github.com/o/r"},
+		{name: "users", value: usersValue([]string{"octocat", "hubot"}), want: "octocat, hubot"},
+		{name: "reviewers", value: reviewersValue(), want: "maintainers, octocat"},
+		{name: "unknown", value: FieldValueNodes{Type: "Unknown"}, want: ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, tt.value.DisplayValue())
+		})
+	}
+}
+
+func dateValue(date string) FieldValueNodes {
+	v := FieldValueNodes{Type: "ProjectV2ItemFieldDateValue"}
+	v.ProjectV2ItemFieldDateValue.Date = date
+	return v
+}
