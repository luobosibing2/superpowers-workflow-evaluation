+++ b/pkg/cmd/project/shared/queries/queries.go
@@ -720,6 +720,46 @@ func (c *Client) ProjectItems(o *Owner, number int32, limit int, queryStr string
 	return project, nil
 }
 
+// CompleteProjectFields returns all project fields, reusing the already fetched
+// first page and requesting additional pages only when necessary.
+func (c *Client) CompleteProjectFields(o *Owner, number int32, fields ProjectFields) ([]ProjectField, error) {
+	if !fields.PageInfo.HasNextPage {
+		return fields.Nodes, nil
+	}
+
+	variables := map[string]interface{}{
+		"firstItems":  githubv4.Int(LimitMax),
+		"afterItems":  (*githubv4.String)(nil),
+		"firstFields": githubv4.Int(LimitMax),
+		"afterFields": (*githubv4.String)(&fields.PageInfo.EndCursor),
+		"number":      githubv4.Int(number),
+	}
+
+	var query pager[ProjectField]
+	var queryName string
+	switch o.Type {
+	case UserOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &userOwnerWithFields{}
+		queryName = "UserProjectWithFields"
+	case OrgOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &orgOwnerWithFields{}
+		queryName = "OrgProjectWithFields"
+	case ViewerOwner:
+		query = &viewerOwnerWithFields{}
+		queryName = "ViewerProjectWithFields"
+	}
+
+	if err := c.doQueryWithProgressIndicator(queryName, query, variables); err != nil {
+		return nil, err
+	}
+
+	allFields := append([]ProjectField{}, fields.Nodes...)
+	allFields = append(allFields, query.Nodes()...)
+	return paginateAttributes(c, query, variables, queryName, "firstFields", "afterFields", int(^uint(0)>>1), allFields)
+}
+
 // pager is an interface for paginating over the attributes of a Project.
 type pager[N projectAttribute] interface {
 	HasNextPage() bool
