+func fieldValue(item queries.ProjectItem, fieldID string) string {
+	for _, value := range item.FieldValues.Nodes {
+		if value.ID() == fieldID {
+			return normalizeCell(formatFieldValue(value))
+		}
+	}
+	return ""
