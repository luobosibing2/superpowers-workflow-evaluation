+// ProjectFieldsAfter retrieves every field page after initial. The initial page
+// is returned by ProjectItems, allowing callers that need field metadata to
+// avoid retrieving it again.
+func (c *Client) ProjectFieldsAfter(o *Owner, number int32, initial ProjectFields) ([]ProjectField, error) {
+	fields := initial.Nodes
+	hasNextPage := initial.PageInfo.HasNextPage
+	cursor := initial.PageInfo.EndCursor
+
+	for hasNextPage {
+		variables := map[string]interface{}{
+			"firstFields": githubv4.Int(LimitMax),
+			"afterFields": (*githubv4.String)(&cursor),
+			"number":      githubv4.Int(number),
+		}
+
+		var query fieldPageQuery
+		var queryName string
+		switch o.Type {
+		case UserOwner:
+			variables["login"] = githubv4.String(o.Login)
+			query = &userOwnerFieldPage{}
+			queryName = "UserProjectFieldPage"
+		case OrgOwner:
+			variables["login"] = githubv4.String(o.Login)
+			query = &orgOwnerFieldPage{}
+			queryName = "OrgProjectFieldPage"
+		case ViewerOwner:
+			query = &viewerOwnerFieldPage{}
+			queryName = "ViewerProjectFieldPage"
+		}
+
+		if err := c.doQueryWithProgressIndicator(queryName, query, variables); err != nil {
+			return nil, err
+		}
+
+		page := query.Fields()
+		fields = append(fields, page.Nodes...)
+		hasNextPage = page.PageInfo.HasNextPage
+		cursor = page.PageInfo.EndCursor
+	}
+
+	return fields, nil
+}
