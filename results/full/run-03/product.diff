+func TestRunList_SelectedFieldErrorsDoNotPrint(t *testing.T) {
+	t.Run("unknown field", func(t *testing.T) {
+		defer gock.Off()
+		registerItemListUserOwner()
+		registerItemListItemsResponse(map[string]interface{}{
+			"nodes": []map[string]interface{}{itemListIssue("issue ID", "an issue")},
+		}, map[string]interface{}{
+			"nodes": []map[string]interface{}{{"__typename": "ProjectV2Field", "id": "PVTF_status", "name": "Status", "dataType": "TEXT"}},
+		})
+
+		ios, _, stdout, _ := iostreams.Test()
+		err := runList(listConfig{
+			opts:   listOpts{number: 1, owner: "monalisa", fields: []string{"priority"}},
+			client: queries.NewTestClient(),
+			io:     ios,
+		})
+		assert.EqualError(t, err, "field \"priority\" not found in project; available fields: Status")
+		assert.Empty(t, stdout.String())
+	})
+
+	t.Run("field completion fails", func(t *testing.T) {
+		defer gock.Off()
+		registerItemListUserOwner()
+		registerItemListItemsResponse(map[string]interface{}{
+			"nodes": []map[string]interface{}{itemListIssue("issue ID", "an issue")},
+		}, map[string]interface{}{
+			"nodes":      []map[string]interface{}{},
+			"totalCount": 101,
+			"pageInfo":   map[string]interface{}{"hasNextPage": true},
+		})
+		gock.New("https://api.github.com").
+			Post("/graphql").
+			Reply(200).
+			JSON(map[string]interface{}{"errors": []map[string]interface{}{{"message": "field retrieval failed"}}})
+
+		ios, _, stdout, _ := iostreams.Test()
+		err := runList(listConfig{
+			opts:   listOpts{number: 1, owner: "monalisa", fields: []string{"status"}},
+			client: queries.NewTestClient(),
+			io:     ios,
