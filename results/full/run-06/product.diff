+func TestPrintResults_SelectedFields(t *testing.T) {
+	ios, _, stdout, _ := iostreams.Test()
+	ios.SetStdoutTTY(true)
+	status := projectTextField("PVTF_status", "Status")
+	details := projectTextField("PVTF_details", "Details")
+	absent := projectTextField("PVTF_absent", "Absent")
+	item := queries.ProjectItem{Id: "item ID"}
+	item.Content.TypeName = "DraftIssue"
+	item.Content.DraftIssue.Title = "a draft"
+	item.FieldValues.Nodes = []queries.FieldValueNodes{
+		textFieldValue(details, "x\r\ny\nz"),
+		textFieldValue(status, "done"),
+	}
+
+	err := printResults(listConfig{
+		io:     ios,
+		opts:   listOpts{number: 1},
+		fields: []queries.ProjectField{status, details, status, absent},
+	}, []queries.ProjectItem{item}, "monalisa")
+
+	require.NoError(t, err)
+	output := stdout.String()
+	rows := strings.Split(strings.TrimSuffix(output, "\n"), "\n")
+	require.Len(t, rows, 2)
+	assert.Less(t, strings.Index(output, "STATUS"), strings.Index(output, "DETAILS"))
+	assert.Equal(t, 2, strings.Count(output, "STATUS"))
+	assert.Equal(t, 2, strings.Count(output, "done"))
+	assert.Equal(t, 1, strings.Count(output, "a draft"), "the text field must not split the item into multiple table rows")
+	assert.Equal(t, 1, strings.Count(output, "x  y z"), "the CR/LF-containing text must remain in one table cell")
+	assert.NotContains(t, output, "\r")
+	absentColumn := strings.LastIndex(rows[0], "ABSENT")
+	require.GreaterOrEqual(t, absentColumn, 0)
+	assert.Empty(t, strings.TrimSpace(rows[1][absentColumn:]), "the absent field must render as a blank table cell")
+}
