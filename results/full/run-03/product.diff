+package itemlist
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/cli/cli/v2/pkg/cmd/project/shared/queries"
+)
+
+var cellWhitespace = strings.NewReplacer("\r\n", " ", "\n", " ", "\r", " ")
+
+func resolveSelectedFields(project *queries.Project, opts listOpts) ([]queries.ProjectField, error) {
+	selected := make([]queries.ProjectField, 0, len(opts.fields)+len(opts.fieldIDs))
+	for _, name := range opts.fields {
+		field, err := queries.ResolveFieldByName(project.Fields.Nodes, name)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	for _, id := range opts.fieldIDs {
+		field, err := queries.ResolveFieldByID(project.Fields.Nodes, id)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	return selected, nil
+}
+
+func fieldValue(item queries.ProjectItem, fieldID string) string {
+	for _, node := range item.FieldValues.Nodes {
+		if node.ID() != fieldID {
+			continue
+		}
+
+		var value string
+		switch node.Type {
+		case "ProjectV2ItemFieldDateValue":
+			value = node.ProjectV2ItemFieldDateValue.Date
+		case "ProjectV2ItemFieldIterationValue":
+			value = node.ProjectV2ItemFieldIterationValue.Title
+		case "ProjectV2ItemFieldNumberValue":
+			value = strconv.FormatFloat(node.ProjectV2ItemFieldNumberValue.Number, 'f', -1, 64)
+		case "ProjectV2ItemFieldSingleSelectValue":
+			value = node.ProjectV2ItemFieldSingleSelectValue.Name
+		case "ProjectV2ItemFieldTextValue":
+			value = node.ProjectV2ItemFieldTextValue.Text
+		case "ProjectV2ItemFieldMilestoneValue":
+			value = node.ProjectV2ItemFieldMilestoneValue.Milestone.Title
+		case "ProjectV2ItemFieldLabelValue":
+			labels := make([]string, 0, len(node.ProjectV2ItemFieldLabelValue.Labels.Nodes))
+			for _, label := range node.ProjectV2ItemFieldLabelValue.Labels.Nodes {
+				labels = append(labels, label.Name)
+			}
+			value = strings.Join(labels, ", ")
+		case "ProjectV2ItemFieldPullRequestValue":
+			urls := make([]string, 0, len(node.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes))
+			for _, pullRequest := range node.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes {
+				urls = append(urls, pullRequest.Url)
+			}
+			value = strings.Join(urls, ", ")
+		case "ProjectV2ItemFieldRepositoryValue":
+			value = node.ProjectV2ItemFieldRepositoryValue.Repository.Url
+		case "ProjectV2ItemFieldUserValue":
+			logins := make([]string, 0, len(node.ProjectV2ItemFieldUserValue.Users.Nodes))
+			for _, user := range node.ProjectV2ItemFieldUserValue.Users.Nodes {
+				logins = append(logins, user.Login)
+			}
+			value = strings.Join(logins, ", ")
+		case "ProjectV2ItemFieldReviewerValue":
+			reviewers := make([]string, 0, len(node.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes))
+			for _, reviewer := range node.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes {
+				switch reviewer.Type {
+				case "Team":
+					reviewers = append(reviewers, reviewer.Team.Name)
+				case "User":
+					reviewers = append(reviewers, reviewer.User.Login)
+				}
+			}
+			value = strings.Join(reviewers, ", ")
+		}
+		return cellWhitespace.Replace(value)
+	}
+	return ""
+}
