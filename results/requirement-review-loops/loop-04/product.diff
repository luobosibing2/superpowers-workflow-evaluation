+func printResultsWithFields(config listConfig, items []queries.ProjectItem, login string, fields []queries.ProjectField) error {
+	if len(items) == 0 {
+		return cmdutil.NewNoResultsError(fmt.Sprintf("Project %d for owner %s has no items", config.opts.number, login))
+	}
+
+	headers := []string{"Type", "Title", "Number", "Repository", "ID"}
+	for _, field := range fields {
+		headers = append(headers, field.Name())
+	}
+	tp := tableprinter.New(config.io, tableprinter.WithHeader(headers...))
+
+	for _, item := range items {
+		tp.AddField(item.Type())
+		tp.AddField(item.Title())
+		if item.Number() == 0 {
+			tp.AddField("")
+		} else {
+			tp.AddField(strconv.Itoa(item.Number()))
+		}
+		tp.AddField(item.Repo())
+		tp.AddField(item.ID(), tableprinter.WithTruncate(nil))
+		for _, field := range fields {
+			tp.AddField(normalizeSelectedFieldValue(itemFieldValue(item, field.ID())))
+		}
+		tp.EndRow()
+	}
+
+	return tp.Render()
+}
+
+func itemFieldValue(item queries.ProjectItem, id string) string {
+	for _, value := range item.FieldValues.Nodes {
+		if value.ID() != id {
+			continue
+		}
+		return displayFieldValue(value)
+	}
+	return ""
+}
+
+func displayFieldValue(value queries.FieldValueNodes) string {
+	switch value.Type {
+	case "ProjectV2ItemFieldDateValue":
+		return value.ProjectV2ItemFieldDateValue.Date
+	case "ProjectV2ItemFieldIterationValue":
+		return value.ProjectV2ItemFieldIterationValue.Title
+	case "ProjectV2ItemFieldLabelValue":
+		values := make([]string, 0, len(value.ProjectV2ItemFieldLabelValue.Labels.Nodes))
+		for _, label := range value.ProjectV2ItemFieldLabelValue.Labels.Nodes {
+			values = append(values, label.Name)
+		}
+		return strings.Join(values, ", ")
+	case "ProjectV2ItemFieldNumberValue":
+		return strconv.FormatFloat(value.ProjectV2ItemFieldNumberValue.Number, 'f', -1, 64)
+	case "ProjectV2ItemFieldSingleSelectValue":
+		return value.ProjectV2ItemFieldSingleSelectValue.Name
+	case "ProjectV2ItemFieldTextValue":
+		return value.ProjectV2ItemFieldTextValue.Text
+	case "ProjectV2ItemFieldMilestoneValue":
+		return value.ProjectV2ItemFieldMilestoneValue.Milestone.Title
+	case "ProjectV2ItemFieldPullRequestValue":
+		values := make([]string, 0, len(value.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes))
+		for _, pullRequest := range value.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes {
+			values = append(values, pullRequest.Url)
+		}
+		return strings.Join(values, ", ")
+	case "ProjectV2ItemFieldRepositoryValue":
+		return value.ProjectV2ItemFieldRepositoryValue.Repository.Url
+	case "ProjectV2ItemFieldUserValue":
+		values := make([]string, 0, len(value.ProjectV2ItemFieldUserValue.Users.Nodes))
+		for _, user := range value.ProjectV2ItemFieldUserValue.Users.Nodes {
+			values = append(values, user.Login)
+		}
+		return strings.Join(values, ", ")
+	case "ProjectV2ItemFieldReviewerValue":
+		values := make([]string, 0, len(value.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes))
+		for _, reviewer := range value.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes {
+			if reviewer.Type == "Team" {
+				values = append(values, reviewer.Team.Name)
+			} else if reviewer.Type == "User" {
+				values = append(values, reviewer.User.Login)
+			}
+		}
+		return strings.Join(values, ", ")
+	}
+	return ""
+}
+
+func normalizeSelectedFieldValue(value string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(value, "\r", ""), "\n", " ")
+}
