+	iteration.ProjectV2ItemFieldIterationValue.Title = "Sprint 1"
+
+	labels := FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue"}
+	labels.ProjectV2ItemFieldLabelValue.Field = field
+	labels.ProjectV2ItemFieldLabelValue.Labels.Nodes = append(labels.ProjectV2ItemFieldLabelValue.Labels.Nodes,
+		struct{ Name string }{Name: "bug"},
+		struct{ Name string }{Name: "urgent"},
+	)
+
+	number := FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue"}
+	number.ProjectV2ItemFieldNumberValue.Field = field
+	number.ProjectV2ItemFieldNumberValue.Number = 2.5
+
+	singleSelect := FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	singleSelect.ProjectV2ItemFieldSingleSelectValue.Field = field
+	singleSelect.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+
+	text := FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	text.ProjectV2ItemFieldTextValue.Field = field
+	text.ProjectV2ItemFieldTextValue.Text = "Notes"
+
+	milestone := FieldValueNodes{Type: "ProjectV2ItemFieldMilestoneValue"}
+	milestone.ProjectV2ItemFieldMilestoneValue.Field = field
+	milestone.ProjectV2ItemFieldMilestoneValue.Milestone.Title = "v1.0"
+
+	pullRequests := FieldValueNodes{Type: "ProjectV2ItemFieldPullRequestValue"}
+	pullRequests.ProjectV2ItemFieldPullRequestValue.Field = field
+	pullRequests.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes = append(pullRequests.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes,
+		struct{ Url string }{Url: "https://github.com/cli/cli/pull/1"},
+		struct{ Url string }{Url: "https://github.com/cli/cli/pull/2"},
+	)
+
+	repository := FieldValueNodes{Type: "ProjectV2ItemFieldRepositoryValue"}
+	repository.ProjectV2ItemFieldRepositoryValue.Field = field
+	repository.ProjectV2ItemFieldRepositoryValue.Repository.Url = "https://github.com/cli/cli"
+
+	users := FieldValueNodes{Type: "ProjectV2ItemFieldUserValue"}
+	users.ProjectV2ItemFieldUserValue.Field = field
+	users.ProjectV2ItemFieldUserValue.Users.Nodes = append(users.ProjectV2ItemFieldUserValue.Users.Nodes,
+		struct{ Login string }{Login: "monalisa"},
+		struct{ Login string }{Login: "hubot"},
+	)
+
+	reviewers := FieldValueNodes{Type: "ProjectV2ItemFieldReviewerValue"}
+	reviewers.ProjectV2ItemFieldReviewerValue.Field = field
+	reviewers.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes = append(reviewers.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes,
+		struct {
+			Type string `graphql:"__typename"`
+			Team struct {
+				Name string
+			} `graphql:"... on Team"`
+			User struct {
+				Login string
+			} `graphql:"... on User"`
+		}{Type: "Team"},
+		struct {
+			Type string `graphql:"__typename"`
+			Team struct {
+				Name string
+			} `graphql:"... on Team"`
+			User struct {
+				Login string
+			} `graphql:"... on User"`
+		}{Type: "User"},
+	)
+	reviewers.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes[0].Team.Name = "maintainers"
+	reviewers.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes[1].User.Login = "monalisa"
+
+	tests := []struct {
+		name  string
+		value FieldValueNodes
+		want  string
+	}{
+		{name: "date", value: date, want: "2026-07-31"},
+		{name: "iteration", value: iteration, want: "Sprint 1"},
+		{name: "labels", value: labels, want: "bug, urgent"},
+		{name: "number", value: number, want: "2.5"},
+		{name: "single select", value: singleSelect, want: "In Progress"},
+		{name: "text", value: text, want: "Notes"},
+		{name: "milestone", value: milestone, want: "v1.0"},
+		{name: "pull requests", value: pullRequests, want: "https://github.com/cli/cli/pull/1, https://github.com/cli/cli/pull/2"},
