+func TestPrintResults_SelectedFields(t *testing.T) {
+	status := queries.ProjectField{TypeName: "ProjectV2SingleSelectField"}
+	status.SingleSelectField.ID = "PVTSSF_status"
+	status.SingleSelectField.Name = "Status"
+
+	priority := queries.ProjectField{TypeName: "ProjectV2Field"}
+	priority.Field.ID = "PVTF_priority"
+	priority.Field.Name = "Priority"
+
+	item := queries.ProjectItem{
+		Id: "item ID",
+		Content: queries.ProjectItemContent{
+			TypeName: "Issue",
+		},
+	}
+	item.Content.Issue.Title = "an issue"
+	item.Content.Issue.Number = 1
+	item.Content.Issue.Repository.NameWithOwner = "cli/go-gh"
+
+	statusValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Field = status
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+	priorityValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue"}
+	priorityValue.ProjectV2ItemFieldNumberValue.Field = priority
+	priorityValue.ProjectV2ItemFieldNumberValue.Number = 2.5
+	item.FieldValues.Nodes = []queries.FieldValueNodes{statusValue, priorityValue}
+
+	ios, _, stdout, _ := iostreams.Test()
+	err := printResults(listConfig{io: ios, opts: listOpts{number: 1}}, []queries.ProjectItem{item}, "monalisa", []queries.ProjectField{status, priority})
+	require.NoError(t, err)
+	assert.Equal(t, "Issue\tan issue\t1\tcli/go-gh\titem ID\tIn Progress\t2.5\n", stdout.String())
+}
+
+func TestResolveSelectedFields_UsesReturnedProjectFields(t *testing.T) {
+	status := queries.ProjectField{TypeName: "ProjectV2SingleSelectField"}
+	status.SingleSelectField.ID = "PVTSSF_status"
+	status.SingleSelectField.Name = "Status"
+
+	project := &queries.Project{}
+	project.Fields.Nodes = []queries.ProjectField{status}
+
+	t.Run("name is case insensitive", func(t *testing.T) {
+		config := listConfig{opts: listOpts{fields: []string{"status"}}}
+		fields, err := resolveSelectedFields(config, nil, project)
+		require.NoError(t, err)
+		require.Len(t, fields, 1)
+		assert.Equal(t, status.ID(), fields[0].ID())
+	})
+
+	t.Run("id does not make a preflight request", func(t *testing.T) {
+		config := listConfig{opts: listOpts{fieldIDs: []string{status.ID()}}}
+		fields, err := resolveSelectedFields(config, nil, project)
+		require.NoError(t, err)
+		require.Len(t, fields, 1)
+		assert.Equal(t, status.Name(), fields[0].Name())
+	})
+}
