+func resolveSelectedFields(projectFields []queries.ProjectField, fields, fieldIDs []string) ([]queries.ProjectField, error) {
+	selections := fields
+	resolve := queries.ResolveFieldByName
+	if len(fieldIDs) > 0 {
+		selections = fieldIDs
+		resolve = queries.ResolveFieldByID
+	}
+
+	resolvedFields := make([]queries.ProjectField, 0, len(selections))
+	for _, selection := range selections {
+		field, err := resolve(projectFields, selection)
+		if err != nil {
+			return nil, err
+		}
+		resolvedFields = append(resolvedFields, field)
+	}
+	return resolvedFields, nil
+}
