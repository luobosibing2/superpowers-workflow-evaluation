+// ProjectFieldsAfter returns all project fields after completing pagination
+// from the cursor contained in initial.
+func (c *Client) ProjectFieldsAfter(o *Owner, number int32, initial ProjectFields) (ProjectFields, error) {
+	if !initial.PageInfo.HasNextPage {
+		return initial, nil
+	}
+
+	variables := map[string]interface{}{
+		"firstItems":  githubv4.Int(LimitMax),
+		"afterItems":  (*githubv4.String)(nil),
+		"firstFields": githubv4.Int(LimitMax),
+		"afterFields": (*githubv4.String)(&initial.PageInfo.EndCursor),
+		"number":      githubv4.Int(number),
+	}
+	query, queryName, err := projectFieldsPagerForOwner(o, variables)
+	if err != nil {
+		return initial, err
+	}
+	if err := c.doQueryWithProgressIndicator(queryName, query, variables); err != nil {
+		return initial, err
+	}
+
+	fields := append(initial.Nodes, query.Nodes()...)
+	fields, err = paginateAttributes(c, query, variables, queryName, "firstFields", "afterFields", initial.TotalCount, fields)
+	if err != nil {
+		return initial, err
+	}
+	initial.Nodes = fields
+	initial.PageInfo = query.Project().Fields.PageInfo
+	return initial, nil
+}
+
+func projectFieldsPagerForOwner(o *Owner, variables map[string]interface{}) (pager[ProjectField], string, error) {
+	if o == nil {
+		return nil, "", errors.New("unknown owner type")
+	}
+
+	switch o.Type {
+	case UserOwner:
+		variables["login"] = githubv4.String(o.Login)
+		return &userOwnerWithFields{}, "UserProjectWithFields", nil
+	case OrgOwner:
+		variables["login"] = githubv4.String(o.Login)
+		return &orgOwnerWithFields{}, "OrgProjectWithFields", nil
+	case ViewerOwner:
+		return &viewerOwnerWithFields{}, "ViewerProjectWithFields", nil
+	default:
+		return nil, "", errors.New("unknown owner type")
+	}
+}
