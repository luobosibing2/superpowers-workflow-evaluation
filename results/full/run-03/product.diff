+package itemlist
+
+import (
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/cmd/project/shared/queries"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestResolveSelectedFields(t *testing.T) {
+	tests := []struct {
+		name    string
+		opts    listOpts
+		fields  []queries.ProjectField
+		wantIDs []string
+		wantErr string
+	}{
+		{
+			name:    "case insensitive canonical name",
+			opts:    listOpts{fields: []string{"status"}},
+			fields:  []queries.ProjectField{projectField("PVTSSF_status", "Status")},
+			wantIDs: []string{"PVTSSF_status"},
+		},
+		{
+			name: "ambiguous field lists sorted IDs",
+			opts: listOpts{fields: []string{"status"}},
+			fields: []queries.ProjectField{
+				projectField("PVTSSF_z", "Status"), projectField("PVTSSF_a", "STATUS"),
+			},
+			wantErr: "field \"status\" is ambiguous; multiple fields share this name (use --field-id with one of: PVTSSF_a, PVTSSF_z)",
+		},
+		{
+			name:    "preserves requested ID order",
+			opts:    listOpts{fieldIDs: []string{"PVTF_priority", "PVTF_status"}},
+			fields:  []queries.ProjectField{projectField("PVTF_status", "Status"), projectField("PVTF_priority", "Priority")},
+			wantIDs: []string{"PVTF_priority", "PVTF_status"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			project := &queries.Project{}
+			project.Fields.Nodes = tt.fields
+
+			got, err := resolveSelectedFields(project, tt.opts)
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+
+			gotIDs := make([]string, len(got))
+			for i := range got {
+				gotIDs[i] = got[i].ID()
+			}
+			assert.Equal(t, tt.wantIDs, gotIDs)
+		})
+	}
+}
+
+func TestFieldValue(t *testing.T) {
+	item := queries.ProjectItem{}
+	item.FieldValues.Nodes = []queries.FieldValueNodes{
+		dateValue("date", "2024-01-02"),
+		iterationValue("iteration", "Sprint 1"),
+		numberValue("whole", 1),
+		numberValue("fraction", 1.5),
+		singleSelectValue("status", "In Progress"),
+		textValue("text", "first\r\nsecond\rthird"),
+		milestoneValue("milestone", "v1.0"),
+		labelsValue("labels", "bug", "help wanted"),
+		pullRequestsValue("pulls", "https://github.com/cli/cli/pull/1", "https://github.com/cli/cli/pull/2"),
+		repositoryValue("repository", "https://github.com/cli/cli"),
+		usersValue("assignees", "monalisa", "hubot"),
+		reviewersValue("reviewers", "Team", "cli", "User", "monalisa"),
+	}
+
+	tests := []struct {
+		name    string
+		fieldID string
+		want    string
+	}{
+		{name: "date", fieldID: "date", want: "2024-01-02"},
+		{name: "iteration title", fieldID: "iteration", want: "Sprint 1"},
+		{name: "whole number", fieldID: "whole", want: "1"},
+		{name: "fractional number", fieldID: "fraction", want: "1.5"},
+		{name: "single select", fieldID: "status", want: "In Progress"},
+		{name: "text normalizes newlines", fieldID: "text", want: "first second third"},
+		{name: "milestone title", fieldID: "milestone", want: "v1.0"},
+		{name: "labels", fieldID: "labels", want: "bug, help wanted"},
+		{name: "pull request URLs", fieldID: "pulls", want: "https://github.com/cli/cli/pull/1, https://github.com/cli/cli/pull/2"},
+		{name: "repository URL", fieldID: "repository", want: "https://github.com/cli/cli"},
+		{name: "user logins", fieldID: "assignees", want: "monalisa, hubot"},
+		{name: "team and user reviewers", fieldID: "reviewers", want: "cli, monalisa"},
+		{name: "missing value", fieldID: "missing", want: ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, fieldValue(item, tt.fieldID))
+		})
+	}
+}
+
+func projectField(id, name string) queries.ProjectField {
+	field := queries.ProjectField{TypeName: "ProjectV2Field"}
+	field.Field.ID = id
+	field.Field.Name = name
+	return field
+}
+
+func dateValue(id, date string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldDateValue"}
+	value.ProjectV2ItemFieldDateValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldDateValue.Date = date
+	return value
+}
+
+func iterationValue(id, title string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldIterationValue"}
+	value.ProjectV2ItemFieldIterationValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldIterationValue.Title = title
+	return value
+}
+
+func numberValue(id string, number float64) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue"}
+	value.ProjectV2ItemFieldNumberValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldNumberValue.Number = number
+	return value
+}
+
+func singleSelectValue(id, name string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	value.ProjectV2ItemFieldSingleSelectValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldSingleSelectValue.Name = name
+	return value
+}
+
+func textValue(id, text string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	value.ProjectV2ItemFieldTextValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldTextValue.Text = text
+	return value
+}
+
+func milestoneValue(id, title string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldMilestoneValue"}
+	value.ProjectV2ItemFieldMilestoneValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldMilestoneValue.Milestone.Title = title
+	return value
+}
+
+func labelsValue(id string, names ...string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue"}
+	value.ProjectV2ItemFieldLabelValue.Field = projectField(id, id)
+	for _, name := range names {
+		value.ProjectV2ItemFieldLabelValue.Labels.Nodes = append(value.ProjectV2ItemFieldLabelValue.Labels.Nodes, struct{ Name string }{Name: name})
+	}
+	return value
+}
+
+func pullRequestsValue(id string, urls ...string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldPullRequestValue"}
+	value.ProjectV2ItemFieldPullRequestValue.Field = projectField(id, id)
+	for _, url := range urls {
+		value.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes = append(value.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes, struct{ Url string }{Url: url})
+	}
+	return value
+}
+
+func repositoryValue(id, url string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldRepositoryValue"}
+	value.ProjectV2ItemFieldRepositoryValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldRepositoryValue.Repository.Url = url
+	return value
+}
+
+func usersValue(id string, logins ...string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldUserValue"}
+	value.ProjectV2ItemFieldUserValue.Field = projectField(id, id)
+	for _, login := range logins {
+		value.ProjectV2ItemFieldUserValue.Users.Nodes = append(value.ProjectV2ItemFieldUserValue.Users.Nodes, struct{ Login string }{Login: login})
+	}
+	return value
+}
+
+func reviewersValue(id string, firstType, firstName, secondType, secondName string) queries.FieldValueNodes {
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldReviewerValue"}
+	value.ProjectV2ItemFieldReviewerValue.Field = projectField(id, id)
+	value.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes = append(value.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes,
+		reviewer(firstType, firstName), reviewer(secondType, secondName))
+	return value
+}
+
+func reviewer(typename, name string) struct {
+	Type string `graphql:"__typename"`
+	Team struct {
+		Name string
+	} `graphql:"... on Team"`
+	User struct {
+		Login string
+	} `graphql:"... on User"`
+} {
+	reviewer := struct {
+		Type string `graphql:"__typename"`
+		Team struct {
+			Name string
+		} `graphql:"... on Team"`
+		User struct {
+			Login string
+		} `graphql:"... on User"`
+	}{Type: typename}
+	if typename == "Team" {
+		reviewer.Team.Name = name
+	} else {
+		reviewer.User.Login = name
+	}
+	return reviewer
+}
