+// DisplayValue returns a human-readable representation of a project item field value.
+func (v FieldValueNodes) DisplayValue() string {
+	switch v.Type {
+	case "ProjectV2ItemFieldDateValue":
+		return v.ProjectV2ItemFieldDateValue.Date
+	case "ProjectV2ItemFieldIterationValue":
+		return v.ProjectV2ItemFieldIterationValue.Title
+	case "ProjectV2ItemFieldNumberValue":
+		return strconv.FormatFloat(v.ProjectV2ItemFieldNumberValue.Number, 'f', -1, 64)
+	case "ProjectV2ItemFieldSingleSelectValue":
+		return v.ProjectV2ItemFieldSingleSelectValue.Name
+	case "ProjectV2ItemFieldTextValue":
+		return v.ProjectV2ItemFieldTextValue.Text
+	case "ProjectV2ItemFieldMilestoneValue":
+		return v.ProjectV2ItemFieldMilestoneValue.Milestone.Title
+	case "ProjectV2ItemFieldLabelValue":
+		names := make([]string, 0, len(v.ProjectV2ItemFieldLabelValue.Labels.Nodes))
+		for _, label := range v.ProjectV2ItemFieldLabelValue.Labels.Nodes {
+			names = append(names, label.Name)
+		}
+		return strings.Join(names, ", ")
+	case "ProjectV2ItemFieldPullRequestValue":
+		urls := make([]string, 0, len(v.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes))
+		for _, pullRequest := range v.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes {
+			urls = append(urls, pullRequest.Url)
+		}
+		return strings.Join(urls, ", ")
+	case "ProjectV2ItemFieldRepositoryValue":
+		return v.ProjectV2ItemFieldRepositoryValue.Repository.Url
+	case "ProjectV2ItemFieldUserValue":
+		logins := make([]string, 0, len(v.ProjectV2ItemFieldUserValue.Users.Nodes))
+		for _, user := range v.ProjectV2ItemFieldUserValue.Users.Nodes {
+			logins = append(logins, user.Login)
+		}
+		return strings.Join(logins, ", ")
+	case "ProjectV2ItemFieldReviewerValue":
+		names := make([]string, 0, len(v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes))
+		for _, reviewer := range v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes {
+			if reviewer.Type == "Team" {
+				names = append(names, reviewer.Team.Name)
+			} else if reviewer.Type == "User" {
+				names = append(names, reviewer.User.Login)
+			}
+		}
+		return strings.Join(names, ", ")
+	}
+
+	return ""
+}
