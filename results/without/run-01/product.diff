+func TestFieldValueDisplay(t *testing.T) {
+	tests := []struct {
+		name  string
+		value queries.FieldValueNodes
+		want  string
+	}{
+		{
+			name: "date",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldDateValue"}
+				v.ProjectV2ItemFieldDateValue.Date = "2026-07-29"
+				return v
+			}(),
+			want: "2026-07-29",
+		},
+		{
+			name: "iteration",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldIterationValue"}
+				v.ProjectV2ItemFieldIterationValue.Title = "Sprint 1"
+				return v
+			}(),
+			want: "Sprint 1",
+		},
+		{
+			name: "labels",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue"}
+				v.ProjectV2ItemFieldLabelValue.Labels.Nodes = []struct{ Name string }{{Name: "bug"}, {Name: "urgent"}}
+				return v
+			}(),
+			want: "bug, urgent",
+		},
+		{
+			name: "number",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue"}
+				v.ProjectV2ItemFieldNumberValue.Number = 1.5
+				return v
+			}(),
+			want: "1.5",
+		},
+		{
+			name: "single select",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+				v.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+				return v
+			}(),
+			want: "In Progress",
+		},
+		{
+			name: "text",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+				v.ProjectV2ItemFieldTextValue.Text = "Notes"
+				return v
+			}(),
+			want: "Notes",
+		},
+		{
+			name: "milestone",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldMilestoneValue"}
+				v.ProjectV2ItemFieldMilestoneValue.Milestone.Title = "v1.0"
+				return v
+			}(),
+			want: "v1.0",
+		},
+		{
+			name: "pull requests",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldPullRequestValue"}
+				v.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes = []struct{ Url string }{{Url: "https://github.com/o/r/pull/1"}, {Url: "https://github.com/o/r/pull/2"}}
+				return v
+			}(),
+			want: "https://github.com/o/r/pull/1, https://github.com/o/r/pull/2",
+		},
+		{
+			name: "repository",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldRepositoryValue"}
+				v.ProjectV2ItemFieldRepositoryValue.Repository.Url = "https://github.com/o/r"
+				return v
+			}(),
+			want: "https://github.com/o/r",
+		},
+		{
+			name: "users",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldUserValue"}
+				v.ProjectV2ItemFieldUserValue.Users.Nodes = []struct{ Login string }{{Login: "monalisa"}, {Login: "hubot"}}
+				return v
+			}(),
+			want: "monalisa, hubot",
+		},
+		{
+			name: "reviewers",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldReviewerValue"}
+				v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes = []struct {
+					Type string `graphql:"__typename"`
+					Team struct {
+						Name string
+					} `graphql:"... on Team"`
+					User struct {
+						Login string
+					} `graphql:"... on User"`
+				}{{Type: "Team"}, {Type: "User"}}
+				v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes[0].Team.Name = "core"
+				v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes[1].User.Login = "monalisa"
+				return v
+			}(),
+			want: "core, monalisa",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, fieldValueDisplay(tt.value))
+		})
+	}
+}
