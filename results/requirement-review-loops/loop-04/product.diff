+package itemlist
+
+import (
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/cmd/project/shared/queries"
+	"github.com/cli/cli/v2/pkg/iostreams"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestResolveSelectedFields(t *testing.T) {
+	fields := []queries.ProjectField{
+		projectTextField("PVTF_status", "Status"),
+		projectTextField("PVTF_priority", "Priority"),
+	}
+
+	selected, err := resolveSelectedFields(listOpts{fields: []string{"priority", "STATUS", "Priority"}}, fields)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"PVTF_priority", "PVTF_status", "PVTF_priority"}, []string{selected[0].ID(), selected[1].ID(), selected[2].ID()})
+
+	selected, err = resolveSelectedFields(listOpts{fieldIDs: []string{"PVTF_status", "PVTF_priority"}}, fields)
+	require.NoError(t, err)
+	assert.Equal(t, []string{"Status", "Priority"}, []string{selected[0].Name(), selected[1].Name()})
+}
+
+func TestDisplayFieldValue(t *testing.T) {
+	tests := []struct {
+		name  string
+		value queries.FieldValueNodes
+		want  string
+	}{
+		{
+			name: "date",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldDateValue", ProjectV2ItemFieldDateValue: struct {
+				Date  string
+				Field queries.ProjectField
+			}{Date: "2026-08-01"}},
+			want: "2026-08-01",
+		},
+		{
+			name: "iteration",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldIterationValue", ProjectV2ItemFieldIterationValue: struct {
+				Title       string
+				StartDate   string
+				Duration    int
+				Field       queries.ProjectField
+				IterationId string
+			}{Title: "Sprint 1"}},
+			want: "Sprint 1",
+		},
+		{
+			name: "labels",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue", ProjectV2ItemFieldLabelValue: struct {
+				Labels struct{ Nodes []struct{ Name string } } `graphql:"labels(first: 10)"`
+				Field  queries.ProjectField
+			}{Labels: struct{ Nodes []struct{ Name string } }{Nodes: []struct{ Name string }{{Name: "bug"}, {Name: "help wanted"}}}}},
+			want: "bug, help wanted",
+		},
+		{
+			name: "number",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue", ProjectV2ItemFieldNumberValue: struct {
+				Number float64
+				Field  queries.ProjectField
+			}{Number: 2.5}},
+			want: "2.5",
+		},
+		{
+			name: "single select",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue", ProjectV2ItemFieldSingleSelectValue: struct {
+				Name  string
+				Field queries.ProjectField
+			}{Name: "In progress"}},
+			want: "In progress",
+		},
+		{
+			name: "text",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue", ProjectV2ItemFieldTextValue: struct {
+				Text  string
+				Field queries.ProjectField
+			}{Text: "notes"}},
+			want: "notes",
+		},
+		{
+			name: "milestone",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldMilestoneValue", ProjectV2ItemFieldMilestoneValue: struct {
+				Milestone struct {
+					Title       string
+					Description string
+					DueOn       string
+				}
+				Field queries.ProjectField
+			}{Milestone: struct {
+				Title       string
+				Description string
+				DueOn       string
+			}{Title: "v1"}}},
+			want: "v1",
+		},
+		{
+			name: "repository",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldRepositoryValue", ProjectV2ItemFieldRepositoryValue: struct {
+				Repository struct{ Url string }
+				Field      queries.ProjectField
+			}{Repository: struct{ Url string }{Url: "https://github.com/cli/cli"}}},
+			want: "https://github.com/cli/cli",
+		},
+		{
+			name:  "unknown",
+			value: queries.FieldValueNodes{Type: "Unknown"},
+			want:  "",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, displayFieldValue(tt.value))
+		})
+	}
+}
+
+func TestNormalizeSelectedFieldValue(t *testing.T) {
+	assert.Equal(t, "first second third", normalizeSelectedFieldValue("first\r\nsecond\nthird"))
+}
+
+func TestDisplayFieldValueCollections(t *testing.T) {
+	pullRequests := queries.FieldValueNodes{Type: "ProjectV2ItemFieldPullRequestValue"}
+	pullRequests.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes = []struct{ Url string }{{Url: "https://github.com/cli/cli/pull/1"}, {Url: "https://github.com/cli/cli/pull/2"}}
+	assert.Equal(t, "https://github.com/cli/cli/pull/1, https://github.com/cli/cli/pull/2", displayFieldValue(pullRequests))
+
+	users := queries.FieldValueNodes{Type: "ProjectV2ItemFieldUserValue"}
+	users.ProjectV2ItemFieldUserValue.Users.Nodes = []struct{ Login string }{{Login: "monalisa"}, {Login: "hubot"}}
+	assert.Equal(t, "monalisa, hubot", displayFieldValue(users))
+
+	reviewers := queries.FieldValueNodes{Type: "ProjectV2ItemFieldReviewerValue"}
+	reviewers.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes = []struct {
+		Type string `graphql:"__typename"`
+		Team struct {
+			Name string
+		} `graphql:"... on Team"`
+		User struct {
+			Login string
+		} `graphql:"... on User"`
+	}{
+		{Type: "Team", Team: struct{ Name string }{Name: "cli"}},
+		{Type: "User", User: struct{ Login string }{Login: "octocat"}},
+	}
+	assert.Equal(t, "cli, octocat", displayFieldValue(reviewers))
+}
+
+func TestPrintResultsWithFields(t *testing.T) {
+	status := projectTextField("PVTF_status", "Status")
+	item := queries.ProjectItem{Id: "item ID"}
+	item.Content.TypeName = "Issue"
+	item.Content.Issue.Title = "an issue"
+	item.Content.Issue.Number = 1
+	item.Content.Issue.Repository.NameWithOwner = "cli/cli"
+	textValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	textValue.ProjectV2ItemFieldTextValue.Field = status
+	textValue.ProjectV2ItemFieldTextValue.Text = "in\r\nprogress"
+	item.FieldValues.Nodes = []queries.FieldValueNodes{textValue}
+
+	ios, _, stdout, _ := iostreams.Test()
+	err := printResultsWithFields(listConfig{io: ios, opts: listOpts{number: 1}}, []queries.ProjectItem{item}, "monalisa", []queries.ProjectField{status, status})
+	require.NoError(t, err)
+	assert.Equal(t, "Issue\tan issue\t1\tcli/cli\titem ID\tin progress\tin progress\n", stdout.String())
+	assert.Empty(t, itemFieldValue(item, "PVTF_missing"))
+}
+
+func projectTextField(id, name string) queries.ProjectField {
+	field := queries.ProjectField{TypeName: "ProjectV2Field"}
+	field.Field.ID = id
+	field.Field.Name = name
+	field.Field.DataType = "TEXT"
+	return field
+}
