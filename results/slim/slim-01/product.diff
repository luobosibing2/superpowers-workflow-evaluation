+func TestResolveSelectedFields(t *testing.T) {
+	status := queries.ProjectField{TypeName: "ProjectV2SingleSelectField"}
+	status.SingleSelectField.ID = "PVTSSF_status"
+	status.SingleSelectField.Name = "Status"
+	priority := queries.ProjectField{TypeName: "ProjectV2Field"}
+	priority.Field.ID = "PVTF_priority"
+	priority.Field.Name = "Priority"
+	fields := []queries.ProjectField{status, priority}
+
+	t.Run("resolves names case-insensitively in selector order", func(t *testing.T) {
+		selected, err := resolveSelectedFields(listOpts{fields: []string{"priority", "STATUS"}}, fields)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"PVTF_priority", "PVTSSF_status"}, []string{selected[0].ID(), selected[1].ID()})
+	})
+
+	t.Run("resolves IDs in selector order", func(t *testing.T) {
+		selected, err := resolveSelectedFields(listOpts{fieldIDs: []string{"PVTSSF_status", "PVTF_priority"}}, fields)
+		assert.NoError(t, err)
+		assert.Equal(t, []string{"PVTSSF_status", "PVTF_priority"}, []string{selected[0].ID(), selected[1].ID()})
+	})
+
+	t.Run("returns an actionable error for unknown names", func(t *testing.T) {
+		_, err := resolveSelectedFields(listOpts{fields: []string{"Sprint"}}, fields)
+		assert.EqualError(t, err, `field "Sprint" not found in project; available fields: Priority, Status`)
+	})
+
+	t.Run("returns an actionable error for unknown IDs", func(t *testing.T) {
+		_, err := resolveSelectedFields(listOpts{fieldIDs: []string{"PVTF_missing"}}, fields)
+		assert.EqualError(t, err, `field with ID "PVTF_missing" not found in project; available fields: Priority (PVTF_priority), Status (PVTSSF_status)`)
+	})
+}
+
+func TestPrintResultsWithSelectedFields(t *testing.T) {
+	status := queries.ProjectField{TypeName: "ProjectV2SingleSelectField"}
+	status.SingleSelectField.ID = "PVTSSF_status"
+	status.SingleSelectField.Name = "Status"
+	assignees := queries.ProjectField{TypeName: "ProjectV2Field"}
+	assignees.Field.ID = "PVTF_assignees"
+	assignees.Field.Name = "Assignees"
+
+	item := queries.ProjectItem{Id: "item ID"}
+	item.Content.TypeName = "Issue"
+	item.Content.Issue.Title = "an issue"
+	item.Content.Issue.Number = 1
+	item.Content.Issue.Repository.NameWithOwner = "cli/go-gh"
+	statusValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Field = status
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+	item.FieldValues.Nodes = []queries.FieldValueNodes{statusValue}
+
+	ios, _, stdout, _ := iostreams.Test()
+	config := listConfig{io: ios, opts: listOpts{number: 1}}
+	err := printResults(config, []queries.ProjectItem{item}, "monalisa", []queries.ProjectField{status, assignees})
+	assert.NoError(t, err)
+	assert.Equal(t, "Issue\tan issue\t1\tcli/go-gh\titem ID\tIn Progress\t\n", stdout.String())
+}
