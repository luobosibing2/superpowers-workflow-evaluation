+func TestResolveSelectedFields(t *testing.T) {
+	status := projectField("STATUS_ID", "Status")
+	targetDate := projectField("DATE_ID", "Target date")
+
+	selected, err := resolveSelectedFields([]queries.ProjectField{status, targetDate}, []string{"status"}, []string{"DATE_ID"})
+	require.NoError(t, err)
+	require.Equal(t, []queries.ProjectField{status, targetDate}, selected)
+
+	_, err = resolveSelectedFields([]queries.ProjectField{status}, []string{"missing"}, nil)
+	require.EqualError(t, err, `field "missing" not found in project; available fields: Status`)
+
+	_, err = resolveSelectedFields([]queries.ProjectField{status}, nil, []string{"MISSING_ID"})
+	require.EqualError(t, err, `field with ID "MISSING_ID" not found in project; available fields: Status (STATUS_ID)`)
+}
