diff --git a/pkg/cmd/project/shared/queries/display_value_test.go b/pkg/cmd/project/shared/queries/display_value_test.go
new file mode 100644
index 0000000..d84f341
--- /dev/null
+++ b/pkg/cmd/project/shared/queries/display_value_test.go
@@ -0,0 +1,81 @@
+package queries
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestFieldValueNodesDisplayValue(t *testing.T) {
+	date := FieldValueNodes{Type: "ProjectV2ItemFieldDateValue"}
+	date.ProjectV2ItemFieldDateValue.Date = "2026-07-31"
+
+	iteration := FieldValueNodes{Type: "ProjectV2ItemFieldIterationValue"}
+	iteration.ProjectV2ItemFieldIterationValue.Title = "Sprint 1"
+
+	labels := FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue"}
+	labels.ProjectV2ItemFieldLabelValue.Labels.Nodes = []struct{ Name string }{{Name: "bug"}, {Name: "help wanted"}}
+
+	number := FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue"}
+	number.ProjectV2ItemFieldNumberValue.Number = 1.5
+
+	singleSelect := FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	singleSelect.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+
+	text := FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	text.ProjectV2ItemFieldTextValue.Text = "notes"
+
+	milestone := FieldValueNodes{Type: "ProjectV2ItemFieldMilestoneValue"}
+	milestone.ProjectV2ItemFieldMilestoneValue.Milestone.Title = "v1.0"
+
+	pullRequests := FieldValueNodes{Type: "ProjectV2ItemFieldPullRequestValue"}
+	pullRequests.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes = []struct{ Url string }{{Url: "https://example.com/1"}, {Url: "https://example.com/2"}}
+
+	repository := FieldValueNodes{Type: "ProjectV2ItemFieldRepositoryValue"}
+	repository.ProjectV2ItemFieldRepositoryValue.Repository.Url = "https://github.com/cli/cli"
+
+	users := FieldValueNodes{Type: "ProjectV2ItemFieldUserValue"}
+	users.ProjectV2ItemFieldUserValue.Users.Nodes = []struct{ Login string }{{Login: "monalisa"}, {Login: "hubot"}}
+
+	reviewers := FieldValueNodes{Type: "ProjectV2ItemFieldReviewerValue"}
+	reviewers.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes = []struct {
+		Type string `graphql:"__typename"`
+		Team struct {
+			Name string
+		} `graphql:"... on Team"`
+		User struct {
+			Login string
+		} `graphql:"... on User"`
+	}{{
+		Type: "Team",
+		Team: struct{ Name string }{Name: "maintainers"},
+	}, {
+		Type: "User",
+		User: struct{ Login string }{Login: "octocat"},
+	}}
+
+	tests := []struct {
+		name  string
+		value FieldValueNodes
+		want  string
+	}{
+		{name: "date", value: date, want: "2026-07-31"},
+		{name: "iteration", value: iteration, want: "Sprint 1"},
+		{name: "labels", value: labels, want: "bug, help wanted"},
+		{name: "number", value: number, want: "1.5"},
+		{name: "single select", value: singleSelect, want: "In Progress"},
+		{name: "text", value: text, want: "notes"},
+		{name: "milestone", value: milestone, want: "v1.0"},
+		{name: "pull requests", value: pullRequests, want: "https://example.com/1, https://example.com/2"},
+		{name: "repository", value: repository, want: "https://github.com/cli/cli"},
+		{name: "users", value: users, want: "monalisa, hubot"},
+		{name: "reviewers", value: reviewers, want: "maintainers, octocat"},
+		{name: "unknown", value: FieldValueNodes{Type: "Unknown"}, want: ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, tt.value.DisplayValue())
+		})
+	}
+}
