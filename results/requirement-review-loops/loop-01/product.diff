+package itemlist
+
+import (
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/cmd/project/shared/queries"
+	"github.com/cli/cli/v2/pkg/cmdutil"
+	"github.com/cli/cli/v2/pkg/iostreams"
+	"github.com/google/shlex"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func testField(id, name string) queries.ProjectField {
+	field := queries.ProjectField{TypeName: "ProjectV2Field"}
+	field.Field.ID = id
+	field.Field.Name = name
+	field.Field.DataType = "TEXT"
+	return field
+}
+
+func TestNewCmdList_FieldSelection(t *testing.T) {
+	tests := []struct {
+		name    string
+		cli     string
+		want    listOpts
+		wantErr string
+	}{
+		{
+			name: "names are repeatable",
+			cli:  "1 --field Status --field Priority",
+			want: listOpts{number: 1, limit: queries.LimitDefault, fields: []string{"Status", "Priority"}},
+		},
+		{
+			name: "ids are repeatable",
+			cli:  "1 --field-id PVTF_status --field-id PVTF_priority",
+			want: listOpts{number: 1, limit: queries.LimitDefault, fieldIDs: []string{"PVTF_status", "PVTF_priority"}},
+		},
+		{
+			name:    "names and ids conflict",
+			cli:     "1 --field Status --field-id PVTF_status",
+			wantErr: "`--field` and `--field-id` cannot be used together",
+		},
+		{
+			name:    "formatted output conflicts",
+			cli:     "1 --field Status --format json --jq .items",
+			wantErr: "`--field` and `--field-id` cannot be used with formatted output",
+		},
+	}
+
+	t.Setenv("GH_TOKEN", "auth-token")
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ios, _, _, _ := iostreams.Test()
+			factory := &cmdutil.Factory{IOStreams: ios}
+			var got listOpts
+			cmd := NewCmdList(factory, func(config listConfig) error {
+				got = config.opts
+				return nil
+			})
+			args, err := shlex.Split(tt.cli)
+			require.NoError(t, err)
+			cmd.SetArgs(args)
+			_, err = cmd.ExecuteC()
+			if tt.wantErr != "" {
+				require.EqualError(t, err, tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want.fields, got.fields)
+			assert.Equal(t, tt.want.fieldIDs, got.fieldIDs)
+			assert.Equal(t, tt.want.number, got.number)
+			assert.Equal(t, tt.want.limit, got.limit)
+		})
+	}
+}
+
+func TestSelectedFields_CaseInsensitiveAndRepeated(t *testing.T) {
+	project := &queries.Project{}
+	project.Fields.Nodes = []queries.ProjectField{testField("status-id", "Status")}
+	config := listConfig{
+		client: &queries.Client{},
+		opts: listOpts{
+			fields: []string{"status", "STATUS"},
+		},
+	}
+
+	fields, err := selectedFields(config, project, &queries.Owner{})
+	require.NoError(t, err)
+	assert.Equal(t, []string{"status-id", "status-id"}, []string{fields[0].ID(), fields[1].ID()})
+}
+
+func TestPrintResults_SelectedFieldsUseIDsAndRequestedOrder(t *testing.T) {
+	status := testField("status-id", "Status")
+	priority := testField("priority-id", "Priority")
+	item := queries.ProjectItem{Id: "item-id"}
+	item.Content.TypeName = "Issue"
+	item.Content.Issue.Title = "an issue"
+	item.Content.Issue.Number = 7
+	item.Content.Issue.Repository.NameWithOwner = "cli/cli"
+
+	priorityValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	priorityValue.ProjectV2ItemFieldTextValue.Field = priority
+	priorityValue.ProjectV2ItemFieldTextValue.Text = "high"
+	statusValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	statusValue.ProjectV2ItemFieldTextValue.Field = status
+	statusValue.ProjectV2ItemFieldTextValue.Text = "in progress"
+	item.FieldValues.Nodes = []queries.FieldValueNodes{priorityValue, statusValue}
+
+	ios, _, stdout, _ := iostreams.Test()
+	err := printResults(listConfig{io: ios}, []queries.ProjectItem{item}, "monalisa", []queries.ProjectField{status, priority})
+	require.NoError(t, err)
+	assert.Equal(t, "Issue\tan issue\t7\tcli/cli\titem-id\tin progress\thigh\n", stdout.String())
+}
+
+func TestFieldValueText(t *testing.T) {
+	tests := []struct {
+		name  string
+		value queries.FieldValueNodes
+		want  string
+	}{
+		{
+			name: "date",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldDateValue"}
+				v.ProjectV2ItemFieldDateValue.Date = "2026-08-01"
+				return v
+			}(),
+			want: "2026-08-01",
+		},
+		{
+			name: "iteration",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldIterationValue"}
+				v.ProjectV2ItemFieldIterationValue.Title = "Sprint 1"
+				return v
+			}(),
+			want: "Sprint 1",
+		},
+		{
+			name: "labels",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue"}
+				v.ProjectV2ItemFieldLabelValue.Labels.Nodes = []struct{ Name string }{{Name: "bug"}, {Name: "urgent"}}
+				return v
+			}(),
+			want: "bug, urgent",
+		},
+		{
+			name: "number",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldNumberValue"}
+				v.ProjectV2ItemFieldNumberValue.Number = 1.5
+				return v
+			}(),
+			want: "1.5",
+		},
+		{
+			name: "single select",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+				v.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+				return v
+			}(),
+			want: "In Progress",
+		},
+		{
+			name: "milestone",
+			value: func() queries.FieldValueNodes {
+				v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldMilestoneValue"}
+				v.ProjectV2ItemFieldMilestoneValue.Milestone.Title = "v1"
+				return v
+			}(),
+			want: "v1",
+		},
+		{
+			name:  "unknown",
+			value: queries.FieldValueNodes{Type: "ProjectV2ItemFieldUnknownValue"},
+			want:  "",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, fieldValueText(tt.value))
+		})
+	}
+}
+
+func TestProjectFieldValue_NormalizesLineBreaks(t *testing.T) {
+	field := testField("text-id", "Notes")
+	value := queries.FieldValueNodes{Type: "ProjectV2ItemFieldTextValue"}
+	value.ProjectV2ItemFieldTextValue.Field = field
+	value.ProjectV2ItemFieldTextValue.Text = "first\r\nsecond\rthird"
+	item := queries.ProjectItem{}
+	item.FieldValues.Nodes = []queries.FieldValueNodes{value}
+
+	assert.Equal(t, "first secondthird", projectFieldValue(item, "text-id"))
+	assert.Equal(t, "", projectFieldValue(item, "missing-id"))
+}
