+func resolveSelectedFields(config listConfig, owner *queries.Owner, project *queries.Project) ([]queries.ProjectField, error) {
+	fields := project.Fields
+	if fields.PageInfo.HasNextPage {
+		var err error
+		fields, err = config.client.ProjectFieldsAfter(owner, config.opts.number, fields)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	selected := make([]queries.ProjectField, 0, len(config.opts.fieldNames)+len(config.opts.fieldIDs))
+	for _, name := range config.opts.fieldNames {
+		field, err := queries.ResolveFieldByName(fields.Nodes, name)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	for _, id := range config.opts.fieldIDs {
+		field, err := queries.ResolveFieldByID(fields.Nodes, id)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	return selected, nil
 }
 
