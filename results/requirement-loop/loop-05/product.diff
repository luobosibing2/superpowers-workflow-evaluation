+// DisplayValue returns a human-readable representation of a project item field value.
+func (v FieldValueNodes) DisplayValue() string {
+	var values []string
+	switch v.Type {
+	case "ProjectV2ItemFieldDateValue":
+		return normalizeFieldValue(v.ProjectV2ItemFieldDateValue.Date)
+	case "ProjectV2ItemFieldIterationValue":
+		return normalizeFieldValue(v.ProjectV2ItemFieldIterationValue.Title)
+	case "ProjectV2ItemFieldNumberValue":
+		return strconv.FormatFloat(v.ProjectV2ItemFieldNumberValue.Number, 'f', -1, 64)
+	case "ProjectV2ItemFieldSingleSelectValue":
+		return normalizeFieldValue(v.ProjectV2ItemFieldSingleSelectValue.Name)
+	case "ProjectV2ItemFieldTextValue":
+		return normalizeFieldValue(v.ProjectV2ItemFieldTextValue.Text)
+	case "ProjectV2ItemFieldMilestoneValue":
+		return normalizeFieldValue(v.ProjectV2ItemFieldMilestoneValue.Milestone.Title)
+	case "ProjectV2ItemFieldLabelValue":
+		for _, label := range v.ProjectV2ItemFieldLabelValue.Labels.Nodes {
+			values = append(values, normalizeFieldValue(label.Name))
+		}
+	case "ProjectV2ItemFieldPullRequestValue":
+		for _, pullRequest := range v.ProjectV2ItemFieldPullRequestValue.PullRequests.Nodes {
+			values = append(values, normalizeFieldValue(pullRequest.Url))
+		}
+	case "ProjectV2ItemFieldRepositoryValue":
+		return normalizeFieldValue(v.ProjectV2ItemFieldRepositoryValue.Repository.Url)
+	case "ProjectV2ItemFieldUserValue":
+		for _, user := range v.ProjectV2ItemFieldUserValue.Users.Nodes {
+			values = append(values, normalizeFieldValue(user.Login))
+		}
+	case "ProjectV2ItemFieldReviewerValue":
+		for _, reviewer := range v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes {
+			switch reviewer.Type {
+			case "Team":
+				values = append(values, normalizeFieldValue(reviewer.Team.Name))
+			case "User":
+				values = append(values, normalizeFieldValue(reviewer.User.Login))
+			}
+		}
+	}
+	return strings.Join(values, ", ")
+}
+
+func normalizeFieldValue(value string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(value, "\r", ""), "\n", " ")
+}
