+func TestPrintResults_WithSelectedFields(t *testing.T) {
+	status := projectField("STATUS_ID", "Status")
+	targetDate := projectField("DATE_ID", "Target date")
+
+	statusValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Field = status
+	dateValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldDateValue"}
+	dateValue.ProjectV2ItemFieldDateValue.Date = "2026-07-29"
+	dateValue.ProjectV2ItemFieldDateValue.Field = targetDate
+
+	ios, _, stdout, _ := iostreams.Test()
+	err := printResults(listConfig{io: ios, opts: listOpts{number: 1}}, []queries.ProjectItem{{
+		Id: "item ID",
+		Content: queries.ProjectItemContent{
+			TypeName: "Issue",
+			Issue:    queries.Issue{Title: "an issue", Number: 1},
+		},
+		FieldValues: struct{ Nodes []queries.FieldValueNodes }{Nodes: []queries.FieldValueNodes{statusValue, dateValue}},
+	}}, []queries.ProjectField{status, targetDate}, "monalisa")
+	require.NoError(t, err)
+	assert.Equal(t, "Issue\tan issue\t1\t\titem ID\tIn Progress\t2026-07-29\n", stdout.String())
+}
