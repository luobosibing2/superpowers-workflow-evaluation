+// ProjectItemFields fetches the remaining pages of field definitions for a
+// project whose first field page was returned by ProjectItems. It is a no-op
+// when the first page contains all fields.
+func (c *Client) ProjectItemFields(o *Owner, number int32, project *Project) error {
+	if !project.Fields.PageInfo.HasNextPage {
+		return nil
+	}
+
+	variables := map[string]interface{}{
+		"number":      githubv4.Int(number),
+		"firstFields": githubv4.Int(LimitMax),
+	}
+	if o.Type != ViewerOwner {
+		variables["login"] = githubv4.String(o.Login)
+	}
+
+	fields := project.Fields.Nodes
+	cursor := project.Fields.PageInfo.EndCursor
+	hasNextPage := project.Fields.PageInfo.HasNextPage
+	for hasNextPage {
+		variables["afterFields"] = (*githubv4.String)(&cursor)
+		page, queryName := projectFieldsPage(o)
+		if err := c.doQueryWithProgressIndicator(queryName, page, variables); err != nil {
+			return err
+		}
+		projectFields := page.Fields()
+		fields = append(fields, projectFields.Nodes...)
+		cursor = projectFields.PageInfo.EndCursor
+		hasNextPage = projectFields.PageInfo.HasNextPage
+	}
+	project.Fields.Nodes = fields
+	project.Fields.PageInfo.EndCursor = cursor
+	project.Fields.PageInfo.HasNextPage = false
+	return nil
+}
+
+type projectFieldsPageQuery interface {
+	Fields() ProjectFields
+}
+
+func projectFieldsPage(owner *Owner) (projectFieldsPageQuery, string) {
+	switch owner.Type {
+	case UserOwner:
+		return &userOwnerWithFieldPage{}, "UserProjectFieldPage"
+	case OrgOwner:
+		return &orgOwnerWithFieldPage{}, "OrgProjectFieldPage"
+	default:
+		return &viewerOwnerWithFieldPage{}, "ViewerProjectFieldPage"
+	}
+}
+
+type userOwnerWithFieldPage struct {
+	Owner struct {
+		Project struct {
+			Fields ProjectFields `graphql:"fields(first: $firstFields, after: $afterFields)"`
+		} `graphql:"projectV2(number: $number)"`
+	} `graphql:"user(login: $login)"`
+}
+
+func (q userOwnerWithFieldPage) Fields() ProjectFields {
+	return q.Owner.Project.Fields
+}
+
+type orgOwnerWithFieldPage struct {
+	Owner struct {
+		Project struct {
+			Fields ProjectFields `graphql:"fields(first: $firstFields, after: $afterFields)"`
+		} `graphql:"projectV2(number: $number)"`
+	} `graphql:"organization(login: $login)"`
+}
+
+func (q orgOwnerWithFieldPage) Fields() ProjectFields {
+	return q.Owner.Project.Fields
+}
+
+type viewerOwnerWithFieldPage struct {
+	Viewer struct {
+		Project struct {
+			Fields ProjectFields `graphql:"fields(first: $firstFields, after: $afterFields)"`
+		} `graphql:"projectV2(number: $number)"`
+	}
+}
+
+func (q viewerOwnerWithFieldPage) Fields() ProjectFields {
+	return q.Viewer.Project.Fields
+}
