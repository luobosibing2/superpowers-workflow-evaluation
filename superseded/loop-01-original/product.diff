+// CompleteProjectFields appends every remaining page of project field
+// definitions to initial. It does not make a request when initial is complete.
+func (c *Client) CompleteProjectFields(o *Owner, number int32, initial ProjectFields) ([]ProjectField, error) {
+	fields := append([]ProjectField(nil), initial.Nodes...)
+	if !initial.PageInfo.HasNextPage {
+		return fields, nil
+	}
+
+	cursor := initial.PageInfo.EndCursor
+	variables := map[string]interface{}{
+		"firstFields": githubv4.Int(LimitMax),
+		"afterFields": (*githubv4.String)(&cursor),
+		"number":      githubv4.Int(number),
+	}
+
+	var query pager[ProjectField]
+	var queryName string
+	switch o.Type {
+	case UserOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &userOwnerWithFieldPages{}
+		queryName = "UserProjectFieldPages"
+	case OrgOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &orgOwnerWithFieldPages{}
+		queryName = "OrgProjectFieldPages"
+	case ViewerOwner:
+		query = &viewerOwnerWithFieldPages{}
+		queryName = "ViewerProjectFieldPages"
+	}
+
+	for hasNextPage := true; hasNextPage; {
+		if err := c.doQueryWithProgressIndicator(queryName, query, variables); err != nil {
+			return fields, err
+		}
+		fields = append(fields, query.Nodes()...)
+		hasNextPage = query.HasNextPage()
+		cursor = githubv4.String(query.EndCursor())
+	}
+
+	return fields, nil
+}
+
+// CompleteProjectItemFieldValues fetches additional field-value pages until
+// every requested field has a value or the connection is exhausted.
+func (c *Client) CompleteProjectItemFieldValues(item *ProjectItem, fieldIDs []string) error {
+	if itemHasFieldValues(item, fieldIDs) || !item.FieldValues.PageInfo.HasNextPage {
+		return nil
+	}
+
+	cursor := item.FieldValues.PageInfo.EndCursor
+	variables := map[string]interface{}{
+		"itemID":           githubv4.ID(item.ID()),
+		"firstFieldValues": githubv4.Int(LimitMax),
+		"afterFieldValues": (*githubv4.String)(&cursor),
+	}
+
+	for hasNextPage := true; hasNextPage; {
+		var query projectItemFieldValuesPageQuery
+		if err := c.doQueryWithProgressIndicator("ProjectItemFieldValuePages", &query, variables); err != nil {
+			return err
+		}
+		item.FieldValues.Nodes = append(item.FieldValues.Nodes, query.Node.Item.FieldValues.Nodes...)
+		item.FieldValues.PageInfo = query.Node.Item.FieldValues.PageInfo
+		if itemHasFieldValues(item, fieldIDs) {
+			return nil
+		}
+		hasNextPage = item.FieldValues.PageInfo.HasNextPage
+		cursor = item.FieldValues.PageInfo.EndCursor
+	}
+
+	return nil
+}
+
+func itemHasFieldValues(item *ProjectItem, fieldIDs []string) bool {
+	remaining := make(map[string]struct{}, len(fieldIDs))
+	for _, fieldID := range fieldIDs {
+		remaining[fieldID] = struct{}{}
+	}
+	for _, value := range item.FieldValues.Nodes {
+		delete(remaining, value.ID())
+	}
+	return len(remaining) == 0
+}
