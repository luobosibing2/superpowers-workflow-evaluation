+// RemainingProjectFields retrieves every field-definition page after fields.
+// The supplied fields must be the first page returned by a project query.
+func (c *Client) RemainingProjectFields(o *Owner, number int32, fields ProjectFields) ([]ProjectField, error) {
+	if !fields.PageInfo.HasNextPage {
+		return fields.Nodes, nil
+	}
+
+	cursor := fields.PageInfo.EndCursor
+	variables := map[string]interface{}{
+		"firstFields": githubv4.Int(LimitMax),
+		"afterFields": (*githubv4.String)(&cursor),
+		"number":      githubv4.Int(number),
+	}
+
+	var query pager[ProjectField]
+	var queryName string
+	switch o.Type {
+	case UserOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &userOwnerWithRemainingFields{}
+		queryName = "UserProjectWithFields"
+	case OrgOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &orgOwnerWithRemainingFields{}
+		queryName = "OrgProjectWithFields"
+	case ViewerOwner:
+		query = &viewerOwnerWithRemainingFields{}
+		queryName = "ViewerProjectWithFields"
+	}
+
+	if err := c.doQueryWithProgressIndicator(queryName, query, variables); err != nil {
+		return nil, err
+	}
+
+	nodes := append(fields.Nodes, query.Nodes()...)
+	nodes, err := paginateAttributes(c, query, variables, queryName, "firstFields", "afterFields", int(^uint(0)>>1), nodes)
+	if err != nil {
+		return nil, err
+	}
+	return nodes, nil
+}
