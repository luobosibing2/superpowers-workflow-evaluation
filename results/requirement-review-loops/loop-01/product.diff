+package queries
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/cli/cli/v2/pkg/iostreams"
+	"github.com/shurcooL/githubv4"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type graphqlClientFunc struct {
+	query func(string, interface{}, map[string]interface{}) error
+}
+
+func (c graphqlClientFunc) Query(name string, query interface{}, variables map[string]interface{}) error {
+	return c.query(name, query, variables)
+}
+
+func (graphqlClientFunc) Mutate(string, interface{}, map[string]interface{}) error {
+	return nil
+}
+
+func TestCompleteProjectFields(t *testing.T) {
+	t.Run("does not request fields when the initial page is complete", func(t *testing.T) {
+		calls := 0
+		client := &Client{
+			apiClient: graphqlClientFunc{query: func(string, interface{}, map[string]interface{}) error {
+				calls++
+				return nil
+			}},
+			io: testIO(),
+		}
+		initial := ProjectFields{Nodes: []ProjectField{textField("first", "First")}}
+
+		fields, err := client.CompleteProjectFields(&Owner{Type: UserOwner, Login: "monalisa"}, 1, initial)
+		require.NoError(t, err)
+		assert.Equal(t, initial.Nodes, fields)
+		assert.Zero(t, calls)
+	})
+
+	t.Run("fetches every remaining page", func(t *testing.T) {
+		calls := 0
+		client := &Client{
+			apiClient: graphqlClientFunc{query: func(name string, query interface{}, variables map[string]interface{}) error {
+				calls++
+				assert.Equal(t, "UserProjectWithFields", name)
+				assert.Equal(t, githubv4.Int(LimitMax), variables["firstFields"])
+				cursor, ok := variables["afterFields"].(*githubv4.String)
+				require.True(t, ok)
+				projectQuery := query.(*userOwnerWithFields)
+				switch calls {
+				case 1:
+					assert.Equal(t, "initial-cursor", string(*cursor))
+					projectQuery.Owner.Project.Fields.Nodes = []ProjectField{textField("second", "Second")}
+					projectQuery.Owner.Project.Fields.PageInfo.HasNextPage = true
+					projectQuery.Owner.Project.Fields.PageInfo.EndCursor = githubv4.String("second-cursor")
+				case 2:
+					assert.Equal(t, "second-cursor", string(*cursor))
+					projectQuery.Owner.Project.Fields.Nodes = []ProjectField{textField("third", "Third")}
+					projectQuery.Owner.Project.Fields.PageInfo.HasNextPage = false
+				}
+				return nil
+			}},
+			io: testIO(),
+		}
+		initial := ProjectFields{Nodes: []ProjectField{textField("first", "First")}}
+		initial.PageInfo.HasNextPage = true
+		initial.PageInfo.EndCursor = githubv4.String("initial-cursor")
+
+		fields, err := client.CompleteProjectFields(&Owner{Type: UserOwner, Login: "monalisa"}, 1, initial)
+		require.NoError(t, err)
+		assert.Equal(t, []string{"first", "second", "third"}, []string{fields[0].ID(), fields[1].ID(), fields[2].ID()})
+		assert.Equal(t, 2, calls)
+	})
+
+	t.Run("returns additional-page errors", func(t *testing.T) {
+		client := &Client{
+			apiClient: graphqlClientFunc{query: func(string, interface{}, map[string]interface{}) error {
+				return errors.New("field service unavailable")
+			}},
+			io: testIO(),
+		}
+		initial := ProjectFields{}
+		initial.PageInfo.HasNextPage = true
+		initial.PageInfo.EndCursor = githubv4.String("initial-cursor")
+
+		_, err := client.CompleteProjectFields(&Owner{Type: UserOwner, Login: "monalisa"}, 1, initial)
+		require.EqualError(t, err, "field service unavailable")
+	})
+}
+
+func testIO() *iostreams.IOStreams {
+	io, _, _, _ := iostreams.Test()
+	return io
+}
