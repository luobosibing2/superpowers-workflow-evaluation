+func TestSelectedFields(t *testing.T) {
+	status := queries.ProjectField{TypeName: "ProjectV2SingleSelectField"}
+	status.SingleSelectField.ID = "PVTSSF_status"
+	status.SingleSelectField.Name = "Status"
+	priority := queries.ProjectField{TypeName: "ProjectV2Field"}
+	priority.Field.ID = "PVTF_priority"
+	priority.Field.Name = "Priority"
+
+	fields, err := selectedFields([]queries.ProjectField{status, priority}, []string{"status"}, []string{"PVTF_priority"})
+	require.NoError(t, err)
+	assert.Equal(t, []queries.ProjectField{status, priority}, fields)
+
+	_, err = selectedFields([]queries.ProjectField{status}, []string{"missing"}, nil)
+	require.EqualError(t, err, `field "missing" not found in project; available fields: Status`)
+
+	_, err = selectedFields([]queries.ProjectField{status}, nil, []string{"missing"})
+	require.EqualError(t, err, `field with ID "missing" not found in project; available fields: Status (PVTSSF_status)`)
+}
