+func resolveSelectedFields(config listConfig, owner *queries.Owner, project *queries.Project) ([]queries.ProjectField, error) {
+	if len(config.opts.fields) == 0 && len(config.opts.fieldIDs) == 0 {
+		return nil, nil
+	}
+
+	fields, err := config.client.ProjectFieldsAfter(owner, config.opts.number, project.Fields)
+	if err != nil {
+		return nil, fmt.Errorf("failed to retrieve all project fields: %w", err)
+	}
+
+	selected := make([]queries.ProjectField, 0, len(config.opts.fields)+len(config.opts.fieldIDs))
+	for _, name := range config.opts.fields {
+		field, err := queries.ResolveFieldByName(fields, name)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	for _, id := range config.opts.fieldIDs {
+		field, err := queries.ResolveFieldByID(fields, id)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	return selected, nil
 }
 
