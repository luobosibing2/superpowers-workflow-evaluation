+	v := queries.FieldValueNodes{Type: "ProjectV2ItemFieldReviewerValue"}
+	v.ProjectV2ItemFieldReviewerValue.Field = projectField(id, "Field")
+	userReviewer := struct {
+		Type string                 `graphql:"__typename"`
+		Team struct{ Name string }  `graphql:"... on Team"`
+		User struct{ Login string } `graphql:"... on User"`
+	}{Type: "User"}
+	userReviewer.User.Login = user
+	teamReviewer := userReviewer
+	teamReviewer.Type = "Team"
+	teamReviewer.Team.Name = team
+	v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes = append(v.ProjectV2ItemFieldReviewerValue.Reviewers.Nodes, userReviewer, teamReviewer)
+	return v
+}
