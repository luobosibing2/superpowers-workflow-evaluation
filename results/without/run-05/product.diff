+func resolveSelectedFields(fields []queries.ProjectField, names, ids []string) ([]queries.ProjectField, error) {
+	selected := make([]queries.ProjectField, 0, len(names)+len(ids))
+	for _, name := range names {
+		field, err := queries.ResolveFieldByName(fields, name)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	for _, id := range ids {
+		field, err := queries.ResolveFieldByID(fields, id)
+		if err != nil {
+			return nil, err
+		}
+		selected = append(selected, field)
+	}
+	return selected, nil
 }
 
