+func TestResolveSelectedFields(t *testing.T) {
+	fields := []queries.ProjectField{
+		projectField("PVTF_title", "Title"),
+		projectField("PVTSSF_status", "Status"),
+	}
+
+	selected, err := resolveSelectedFields(fields, []fieldSelection{
+		{name: "status", byName: true},
+		{id: "PVTF_title"},
+		{name: "STATUS", byName: true},
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, []string{"Status", "Title", "Status"}, []string{selected[0].Name(), selected[1].Name(), selected[2].Name()})
+
+	_, err = resolveSelectedFields(fields, []fieldSelection{{name: "missing", byName: true}})
+	assert.EqualError(t, err, "field \"missing\" not found in project; available fields: Status, Title")
+
+	_, err = resolveSelectedFields(fields, []fieldSelection{{id: "PVTF_missing"}})
+	assert.EqualError(t, err, "field with ID \"PVTF_missing\" not found in project; available fields: Status (PVTSSF_status), Title (PVTF_title)")
+}
