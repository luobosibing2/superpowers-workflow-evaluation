+func TestRenderFieldValue(t *testing.T) {
+	field := projectTextField("PVTF_field", "Field")
+	tests := []struct {
+		name  string
+		value queries.FieldValueNodes
+		want  string
+	}{
+		{name: "date", value: dateFieldValue(field, "2026-07-29"), want: "2026-07-29"},
+		{name: "number", value: numberFieldValue(field, 42.5), want: "42.5"},
+		{name: "text normalizes line breaks", value: textFieldValue(field, "one\r\ntwo\nthree"), want: "one  two three"},
+		{name: "single select", value: singleSelectFieldValue(field, "In progress"), want: "In progress"},
+		{name: "iteration", value: iterationFieldValue(field, "Sprint 1"), want: "Sprint 1"},
+		{name: "milestone", value: milestoneFieldValue(field, "v1.0"), want: "v1.0"},
+		{name: "labels", value: labelsFieldValue(field, "bug", "help wanted"), want: "bug, help wanted"},
+		{name: "pull requests", value: pullRequestsFieldValue(field, "https://github.com/cli/cli/pull/1", "https://github.com/cli/cli/pull/2"), want: "https://github.com/cli/cli/pull/1, https://github.com/cli/cli/pull/2"},
+		{name: "repository", value: repositoryFieldValue(field, "https://github.com/cli/cli"), want: "https://github.com/cli/cli"},
+		{name: "users", value: usersFieldValue(field, "monalisa", "hubot"), want: "monalisa, hubot"},
+		{name: "reviewers", value: reviewersFieldValue(field, "monalisa", "cli-team"), want: "monalisa, cli-team"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, renderFieldValue(tt.value))
+		})
+	}
+}
