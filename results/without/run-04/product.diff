+func TestSelectedFieldsAndPrintResults(t *testing.T) {
+	status := queries.ProjectField{TypeName: "ProjectV2SingleSelectField"}
+	status.SingleSelectField.ID = "PVTSSF_status"
+	status.SingleSelectField.Name = "Status"
+	labels := queries.ProjectField{TypeName: "ProjectV2Field"}
+	labels.Field.ID = "PVTF_labels"
+	labels.Field.Name = "Labels"
+
+	fields, err := selectedFields(listOpts{
+		fields:   []string{"status"},
+		fieldIDs: []string{"PVTF_labels"},
+	}, []queries.ProjectField{status, labels})
+	require.NoError(t, err)
+	assert.Equal(t, []queries.ProjectField{status, labels}, fields)
+
+	item := queries.ProjectItem{Id: "item ID"}
+	item.Content.TypeName = "Issue"
+	item.Content.Issue.Title = "an issue"
+	item.Content.Issue.Number = 1
+	item.Content.Issue.Repository.NameWithOwner = "cli/go-gh"
+
+	statusValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldSingleSelectValue"}
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Name = "In Progress"
+	statusValue.ProjectV2ItemFieldSingleSelectValue.Field = status
+	labelsValue := queries.FieldValueNodes{Type: "ProjectV2ItemFieldLabelValue"}
+	labelsValue.ProjectV2ItemFieldLabelValue.Field = labels
+	labelsValue.ProjectV2ItemFieldLabelValue.Labels.Nodes = []struct{ Name string }{
+		{Name: "bug"},
+		{Name: "urgent"},
+	}
+	item.FieldValues.Nodes = []queries.FieldValueNodes{statusValue, labelsValue}
+
+	ios, _, stdout, _ := iostreams.Test()
+	err = printResults(listConfig{
+		opts: listOpts{number: 1},
+		io:   ios,
+	}, []queries.ProjectItem{item}, fields, "monalisa")
+	require.NoError(t, err)
+	assert.Equal(t, "Issue\tan issue\t1\tcli/go-gh\titem ID\tIn Progress\tbug, urgent\n", stdout.String())
+}
