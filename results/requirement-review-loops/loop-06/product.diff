+// CompleteProjectFields fetches every remaining page of field definitions for
+// project. The first page must already have been fetched as part of the project
+// query; this method starts at that page's cursor to avoid fetching it again.
+func (c *Client) CompleteProjectFields(o *Owner, number int32, project *Project) error {
+	if !project.Fields.PageInfo.HasNextPage {
+		return nil
+	}
+
+	variables := map[string]interface{}{
+		"firstItems":  githubv4.Int(0),
+		"afterItems":  (*githubv4.String)(nil),
+		"firstFields": githubv4.Int(LimitMax),
+		"afterFields": (*githubv4.String)(&project.Fields.PageInfo.EndCursor),
+		"number":      githubv4.Int(number),
+	}
+
+	var query pager[ProjectField]
+	var queryName string
+	switch o.Type {
+	case UserOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &userOwnerWithFields{}
+		queryName = "UserProjectWithFields"
+	case OrgOwner:
+		variables["login"] = githubv4.String(o.Login)
+		query = &orgOwnerWithFields{}
+		queryName = "OrgProjectWithFields"
+	case ViewerOwner:
+		query = &viewerOwnerWithFields{}
+		queryName = "ViewerProjectWithFields"
+	default:
+		return errors.New("unknown owner type")
+	}
+
+	for {
+		if err := c.doQueryWithProgressIndicator(queryName, query, variables); err != nil {
+			return fmt.Errorf("fetch additional project fields: %w", err)
+		}
+
+		project.Fields.Nodes = append(project.Fields.Nodes, query.Nodes()...)
+		if !query.HasNextPage() {
+			return nil
+		}
+
+		cursor := githubv4.String(query.EndCursor())
+		variables["afterFields"] = (*githubv4.String)(&cursor)
+	}
+}
+
 // pager is an interface for paginating over the attributes of a Project.
 type pager[N projectAttribute] interface {
 	HasNextPage() bool
