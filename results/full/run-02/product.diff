+func TestResolveSelectedFields(t *testing.T) {
+	owner := &queries.Owner{Type: queries.UserOwner, Login: "monalisa"}
+
+	t.Run("unknown ID lists name and ID candidates", func(t *testing.T) {
+		project := &queries.Project{}
+		project.Fields.Nodes = []queries.ProjectField{projectField("PVTF_priority", "Priority")}
+		_, err := resolveSelectedFields(listConfig{opts: listOpts{fieldIDs: []string{"missing"}}}, owner, project)
+		require.EqualError(t, err, `field with ID "missing" not found in project; available fields: Priority (PVTF_priority)`)
+	})
+
+	t.Run("ambiguous name lists sorted IDs", func(t *testing.T) {
+		project := &queries.Project{}
+		project.Fields.Nodes = []queries.ProjectField{
+			projectField("PVTF_z", "Priority"),
+			projectField("PVTF_a", "PRIORITY"),
+		}
+		_, err := resolveSelectedFields(listConfig{opts: listOpts{fieldNames: []string{"priority"}}}, owner, project)
+		require.EqualError(t, err, `field "priority" is ambiguous; multiple fields share this name (use --field-id with one of: PVTF_a, PVTF_z)`)
+	})
+}
